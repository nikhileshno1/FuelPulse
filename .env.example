# Flask configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-key
FLASK_DEBUG=True
PORT=5001

# MySQL Database configuration (e.g. Aiven Cloud, AWS RDS, or local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fuel_consumption_db

# Default admin credentials (auto-created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
